# ==========================================================
# Variáveis de ambiente — LSN Web Studio
# Copie este ficheiro para ".env.local" e preencha os valores.
# ==========================================================

# Utilizador do GitHub cujos repositórios serão apresentados
# na secção "Git e GitHub". Ex.: lsnwebstudio
NEXT_PUBLIC_GITHUB_USERNAME=SEU-USUARIO

# (Opcional) Token pessoal do GitHub para aumentar o limite
# de pedidos à API pública. Deixe vazio para usar projetos
# demonstrativos incorporados.
GITHUB_TOKEN=

# Link de "click to chat" do WhatsApp (sem o parâmetro ?text=,
# que é adicionado automaticamente pelo código).
NEXT_PUBLIC_WHATSAPP_LINK=https://wa.me/message/UAVSK3MNPK3RD1

# E-mail de contacto exibido no site e usado como fallback (mailto).
NEXT_PUBLIC_CONTACT_EMAIL=lsnwebstudio@gmail.com

# --- Envio de e-mail do formulário de orçamento (Resend) ---
# Crie uma conta grátis em https://resend.com, gere uma API key em
# https://resend.com/api-keys e cole aqui. Sem isto, o formulário usa
# apenas o fallback mailto (o visitante tem de enviar manualmente).
RESEND_API_KEY=

# Para onde os pedidos de orçamento devem chegar (não fica visível no
# site). Se vazio, usa o valor de NEXT_PUBLIC_CONTACT_EMAIL acima.
CONTACT_EMAIL_TO=lsnwebstudio@gmail.com

# Remetente do e-mail enviado pelo Resend. Enquanto o domínio
# lsnwebstudio.com não estiver verificado no Resend, use o remetente
# de testes "onboarding@resend.dev" (só funciona enviando para o
# e-mail com que a conta Resend foi criada). Depois de verificar o
# domínio, troque para algo como "LSN Web Studio <contacto@lsnwebstudio.com>".
RESEND_FROM=LSN Web Studio <onboarding@resend.dev>

# URL público do site (usado no sitemap e metadados).
NEXT_PUBLIC_SITE_URL=https://lsnwebstudio.com
